# SSH Self-Healing Agent Configuration
# Copy to .env and fill in values

# SSH connection (Windows agent → Linux / WSL target)
# Get WSL IP with:  wsl hostname -I
SSH_HOST=YOUR_WSL_USER@YOUR_WSL_IP
SSH_IDENTITY_FILE=C:\Users\YOUR_WINDOWS_USER\.ssh\id_ed25519
SSH_PORT=22
SSH_WORKING_DIR=/tmp
SSH_ALLOW_UNKNOWN_HOSTS=true

# Service on remote Linux host
SERVICE_NAME=billing-api.service
LOG_FILE_PATH=/var/log/billing-api/application.log

# Summary written on the Windows agent host
SUMMARY_OUTPUT_PATH=D:\Flytxt\CCAD\ssh-service-demo\reports\healing-summary.json
REPORTS_DIR=D:\Flytxt\CCAD\ssh-service-demo\reports
API_HOST=0.0.0.0
API_PORT=8000

# Policies
RESTART_COOLDOWN_SECONDS=300
MAX_RETRY_ATTEMPTS=3
STARTUP_TIMEOUT_SECONDS=120
